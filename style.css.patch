/*
FATEBOUND MOBILE POLISH
Append this entire file to the END of style.css.
These overrides aim to make the layout comfortable at 100% mobile zoom.
*/

.mode-button + .mode-button {
    margin-top: 14px;
}

.status-overlay-character-name {
    margin: 0 0 18px;
    color: #eee7da;
    font-size: 21px;
    line-height: 1.3;
    letter-spacing: 2px;
    text-align: center;
    overflow-wrap: anywhere;
}

@media (max-width: 500px) {
    .secondary-content {
        width: calc(100% - 36px);
        max-width: 420px;
        padding-top: 58px;
        padding-bottom: 30px;
    }

    .secondary-content h2 {
        font-size: clamp(25px, 7vw, 32px);
        line-height: 1.2;
        letter-spacing: 4px;
    }

    .secondary-content p {
        margin: 20px 0;
        font-size: 14px;
        line-height: 1.55;
    }

    .mode-question {
        margin-bottom: 18px !important;
    }

    .mode-button {
        min-height: 68px;
        padding: 14px 12px;
        gap: 6px;
    }

    .mode-button strong {
        font-size: 13px;
        letter-spacing: 2.5px;
    }

    .mode-button small {
        font-size: 10px;
        line-height: 1.4;
    }

    .origin-roll-display {
        margin: 20px auto 18px;
        padding: 18px 14px 16px;
    }

    #originResult h3 {
        font-size: clamp(19px, 5.4vw, 24px);
        line-height: 1.35;
        letter-spacing: 1px;
    }

    #originResult > p {
        font-size: 13px;
    }

    .character-status-content {
        width: calc(100% - 36px);
        max-height: calc(100dvh - 28px);
        padding: 58px 0 24px;
    }

    .character-name-section {
        margin: 18px auto 20px;
    }

    .status-section-title {
        font-size: 11px;
        letter-spacing: 3px;
    }

    .status-stat-row {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        padding: 10px 2px;
    }

    .status-stat-name {
        font-size: 10px;
        letter-spacing: 1px;
        white-space: nowrap;
    }

    .status-stat-value {
        min-width: 0;
        font-size: 16px;
        text-align: center;
    }

    .status-stat-potential {
        font-size: 12px;
        letter-spacing: 1px;
    }

    .status-detail-row {
        gap: 8px;
        padding: 10px 2px;
    }

    .status-detail-row span {
        font-size: 10px;
        letter-spacing: 1.2px;
    }

    .status-detail-row strong {
        max-width: 62%;
        font-size: 12px;
        overflow-wrap: anywhere;
    }

    .menu-button {
        min-height: 54px;
        padding: 14px 12px;
        font-size: 12px;
        letter-spacing: 3px;
    }

    .game-menu-button {
        top: 14px;
        left: 14px;
        width: 44px;
        height: 44px;
    }

    .status-overlay-character-name {
        margin-bottom: 14px;
        font-size: 18px;
        letter-spacing: 1.5px;
    }
}
